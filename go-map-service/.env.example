# Server Settings
PORT=8080

# PostgreSQL connection used by main.go. Replace placeholders locally.
# Percent-encode special characters in the username/password.
# Use the TLS settings required by your database provider.
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/YOUR_DB_NAME?sslmode=require

# Frontend URL for CORS
ALLOWED_ORIGIN=http://localhost:5173
