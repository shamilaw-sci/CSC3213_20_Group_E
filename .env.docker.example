# =================================================================
# Thirasara Platform - Docker Environment Configuration Template
# Copy this file to .env before running `docker-compose up --build`
# =================================================================

# -----------------
# General & URLs
# -----------------
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGIN=http://localhost:5173,http://localhost:3000
VITE_API_URL=http://localhost:5000
VITE_MAP_API_URL=http://localhost:8080/api/map/search

# -----------------
# Database (Supabase PostgreSQL)
# -----------------
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
SUPABASE_URL=https://[PROJECT-ID].supabase.co
SUPABASE_KEY=[SUPABASE_ANON_KEY]
SUPABASE_SERVICE_ROLE_KEY=[SUPABASE_SERVICE_ROLE_KEY]

# -----------------
# Authentication & JWT
# -----------------
JWT_SECRET=[YOUR_STRONG_RANDOM_JWT_SECRET_KEY]
GOOGLE_CLIENT_ID=[YOUR_GOOGLE_CLIENT_ID].apps.googleusercontent.com
FACEBOOK_APP_ID=[YOUR_FACEBOOK_APP_ID]

# -----------------
# Payments (PayHere)
# -----------------
PAYHERE_MERCHANT_ID=[YOUR_PAYHERE_MERCHANT_ID]
PAYHERE_MERCHANT_SECRET=[YOUR_PAYHERE_MERCHANT_SECRET]

# -----------------
# Email Notifications (SMTP)
# -----------------
EMAIL_USER=[YOUR_GMAIL_ADDRESS]@gmail.com
EMAIL_PASS=[YOUR_GMAIL_16_CHAR_APP_PASSWORD]

# -----------------
# AI Engine (Google Gemini)
# -----------------
GEMINI_API_KEY=[YOUR_GEMINI_API_KEY]
