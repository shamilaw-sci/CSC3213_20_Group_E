+const users = Object.fromEntries(['AGENT', 'OTHER', 'BUYER', 'SELLER', 'ADMIN', 'PENDING_AGENT', 'REJECTED_AGENT', 'BANNED']
+    .map(key => [key, { id: randomUUID(), role: key === 'OTHER' ? 'AGENT' : key,
