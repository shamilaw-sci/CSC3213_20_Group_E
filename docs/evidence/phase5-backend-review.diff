+const { spawnSync } = require('node:child_process');
+const path = require('node:path');
+const jwt = require('jsonwebtoken');
+const { Client } = require('pg');
+const { inspectLocalStack, validateDatabase, identitySql } = require('./local-stack.cjs');
+
+let stage = 'container/workdir/checksum identity';
+async function main() {
+    const local = inspectLocalStack();
+    const client = new Client(local.database);
+    try {
+        stage = 'read-only database connection';
+        await client.connect();
+        await client.query('BEGIN READ ONLY');
+        stage = 'database marker and ledger identity';
+        validateDatabase((await client.query(identitySql)).rows[0]);
+        const ids = (await client.query('SELECT id FROM public.users ORDER BY id')).rows.map(row => row.id);
+        const key = jwt.sign({ role: 'service_role', iss: 'supabase' }, local.jwtSecret, { expiresIn: '10m' });
+        // Direct PostgREST transport, not Kong. API container routing/secret and DB identity were checked first.
+        stage = 'PostgREST read-only identity cross-check';
+        const response = await fetch(`${local.apiUrl}/users?select=id&order=id`, {
+            headers: { Authorization: `Bearer ${key}` }, redirect: 'error', signal: AbortSignal.timeout(5000),
+        });
+        if (!response.ok || JSON.stringify((await response.json()).map(row => row.id)) !== JSON.stringify(ids)) {
+            throw new Error('Local API and database identity cross-check failed.');
+        }
+        await client.query('ROLLBACK');
+        if (process.argv.includes('--preflight')) {
+            console.log('PASS: stack-c identity, loopback DB/API, marker, canonical files/ledger and API read cross-check. No fixture writes.');
+            return;
+        }
+        const env = Object.fromEntries(['PATH', 'SystemRoot', 'WINDIR', 'TEMP', 'TMP', 'COMSPEC', 'PATHEXT'].filter(name => process.env[name])
+            .map(name => [name, process.env[name]]));
+        Object.assign(env, {
+            NODE_ENV: 'test', JWT_SECRET: 'phase5-isolated-auth-tests-only',
+            SUPABASE_URL: local.apiUrl, SUPABASE_KEY: key,
+            PHASE5_DATABASE: JSON.stringify(local.database), PHASE5_LOCAL_APPROVED: 'stack-c',
+        });
+        console.log('Running real API integration against verified stack-c; external delivery disabled.');
+        stage = 'integration assertions and fixture cleanup';
+        const result = spawnSync(process.execPath, [require.resolve('jest/bin/jest'), '--config',
+            path.join(__dirname, 'jest.config.cjs'), '--runInBand', '--no-cache'], {
+            cwd: path.resolve(__dirname, '..'), env, stdio: 'inherit', timeout: 120000,
+        });
+        if (result.status !== 0) throw new Error('Integration assertions or fixture cleanup failed.');
+        validateDatabase((await client.query(identitySql)).rows[0]);
+        const after = (await client.query('SELECT id FROM public.users ORDER BY id')).rows.map(row => row.id);
+        if (JSON.stringify(after) !== JSON.stringify(ids)) throw new Error('Fixture cleanup changed the starting users set.');
+        console.log('PASS: starting users set and canonical ledger preserved after cleanup.');
+    } finally {
+        await client.end();
+    }
+}
+
+main().catch(() => {
+    // Errors from Docker/pg may contain private generated configuration; never echo them.
+    console.error(`FAIL: local Login/roles integration at ${stage}; credentials suppressed.`);
+    process.exitCode = 1;
+});
diff --git "a/D:\\CSC3213_20_Group_E\\backend-node\\integration\\setup.cjs" "b/D:\\CSC3213_20_Group_E\\backend-node\\integration\\setup.cjs"
new file mode 100644
index 0000000..8347936
--- /dev/null
+++ "b/D:\\CSC3213_20_Group_E\\backend-node\\integration\\setup.cjs"
@@ -0,0 +1,60 @@
+const net = require('node:net');
+const { validateDatabase, identitySql } = require('./local-stack.cjs');
+const { Client } = require('pg');
+const { allowSocket, directRestUrl, allowedAppPorts } = require('./network-policy.cjs');
+
+if (process.env.PHASE5_LOCAL_APPROVED !== 'stack-c' || process.env.NODE_ENV !== 'test'
+    || process.env.SUPABASE_URL !== 'http://127.0.0.1:58321'
+    || process.env.JWT_SECRET !== 'phase5-isolated-auth-tests-only') {
+    throw new Error('Verified integration launcher required.');
+}
+
+// Keep all dotenv calls from loading hosted credentials from the checkout.
+jest.mock('dotenv', () => ({ config: () => ({ parsed: {} }) }));
+jest.mock('../utils/emailService', () => new Proxy({}, {
+    get: (_target, name) => {
+        if (name === '__esModule') return false;
+        return () => { throw new Error('External email is forbidden in Login/roles integration.'); };
+    },
+}));
+jest.mock('../utils/paymentReceiptQueue', () => ({
+    start: () => { throw new Error('Receipt worker must not start in integration.'); },
+    drain: () => { throw new Error('Receipt delivery is forbidden in Login/roles integration.'); },
+}));
+
+// Defense in depth for axios, SMTP, Google and arbitrary TCP clients.
+const originalConnect = net.Socket.prototype.connect;
+net.Socket.prototype.connect = function (...args) {
+    if (!allowSocket(args, allowedAppPorts)) {
+        throw new Error('Unexpected outbound socket refused by integration harness.');
+    }
+    return originalConnect.apply(this, args);
+};
+
+const originalFetch = globalThis.fetch;
+globalThis.fetch = (input, init) => {
+    // Supabase JS normally uses Kong's /rest/v1 prefix. The retained local stack exposes PostgREST directly.
+    const url = directRestUrl(input);
+    return originalFetch(url, { ...init, redirect: 'error', signal: AbortSignal.timeout(5000) });
+};
+
+// Expected 4xx security scenarios produce normal HTTP logger warnings. Keep other output visible.
+for (const method of ['log', 'warn']) {
+    const original = console[method].bind(console);
+    console[method] = (...args) => {
+        if (args.length === 1 && typeof args[0] === 'string'
+            && /^\[HTTP\] (GET|POST) \/api\/(auth\/(login|me|logout)|admin\/(login|verify)) -> [234]\d\d \(\d+ms\)$/.test(args[0])) return;
+        original(...args);
+    };
+}
+
+// Revalidate DB identity inside the child before any test setup can seed users.
+module.exports = async () => {
+    const client = new Client(JSON.parse(process.env.PHASE5_DATABASE));
+    try {
+        await client.connect();
+        await client.query('BEGIN READ ONLY');
+        validateDatabase((await client.query(identitySql)).rows[0]);
+        await client.query('ROLLBACK');
+    } finally { await client.end(); }
+};
diff --git "a/D:\\CSC3213_20_Group_E\\backend-node\\tests\\localStackGuard.test.js" "b/D:\\CSC3213_20_Group_E\\backend-node\\tests\\localStackGuard.test.js"
new file mode 100644
index 0000000..2c1bc28
--- /dev/null
+++ "b/D:\\CSC3213_20_Group_E\\backend-node\\tests\\localStackGuard.test.js"
@@ -0,0 +1,81 @@
+const { validateContainers, validateDatabase, validateWorkdir } = require('../integration/local-stack.cjs');
+
+const container = (kind, port) => ({
+    Name: `/supabase_${kind}_thirasara-phase4-c`,
+    State: { Running: true },
+    Config: {
+        Image: `public.ecr.aws/supabase/${kind === 'db' ? 'postgres:17.11.0.006' : 'postgrest:v16.5'}`,
+        Labels: { 'com.supabase.cli.project': 'thirasara-phase4-c' },
+        Env: kind === 'db' ? ['POSTGRES_PASSWORD=local-only', 'JWT_SECRET=local-test-secret'] : [
+            'PGRST_DB_URI=postgres://authenticator:local-only@supabase_db_thirasara-phase4-c:5432/postgres',
+            'PGRST_JWT_SECRET=local-test-secret',
+        ],
+    },
+    HostConfig: { PortBindings: { [`${kind === 'db' ? 5432 : 3000}/tcp`]: [{ HostIp: '127.0.0.1', HostPort: port }] } },
+    NetworkSettings: {
+        Networks: { 'thirasara-phase4-local': { NetworkID: 'isolated-network' } },
+        Ports: { [`${kind === 'db' ? 5432 : 3000}/tcp`]: [{ HostIp: '127.0.0.1', HostPort: port }] },
+    },
+});
+const pair = () => [container('db', '58322'), container('rest', '58321')];
+const identity = () => ({ database: 'postgres', user: 'postgres', major: 17, marker: true,
+    versions: ['20261030045356', '20261030045416'] });
+
+describe('Phase 5 isolated stack guards (no Docker or database access)', () => {
+    test('accepts only the recorded isolated stack-c endpoints', () => {
+        const result = validateContainers(pair());
+        expect(result.apiUrl).toBe('http://127.0.0.1:58321');
+        expect(result.database.port).toBe(58322);
+    });
+    test('accepts the local signing secret represented by the retained PostgREST JWKS', () => {
+        const snapshots = pair();
+        snapshots[1].Config.Env[1] = 'PGRST_JWT_SECRET=' + JSON.stringify({ keys: [
+            { kty: 'EC', alg: 'ES256', kid: 'public-key' },
+            { kty: 'oct', k: Buffer.from('local-test-secret').toString('base64url') },
+        ] });
+        expect(() => validateContainers(snapshots)).not.toThrow();
+    });
+
+    test.each([
+        ['unexpected name', p => { p[0].Name = '/production'; }],
+        ['unexpected project', p => { p[1].Config.Labels['com.supabase.cli.project'] = 'other'; }],
+        ['unexpected image', p => { p[0].Config.Image = 'unknown/postgres:latest'; }],
+        ['stopped container', p => { p[0].State.Running = false; }],
+        ['public port binding', p => { p[1].HostConfig.PortBindings['3000/tcp'][0].HostIp = '0.0.0.0'; }],
+        ['runtime public binding', p => { p[0].NetworkSettings.Ports['5432/tcp'][0].HostIp = '::'; }],
+        ['wrong port', p => { p[1].HostConfig.PortBindings['3000/tcp'][0].HostPort = '5000'; }],
+        ['missing REST port', p => { p[1].NetworkSettings.Ports = {}; }],
+        ['extra public binding', p => { p[0].HostConfig.PortBindings['9999/tcp'] = [{ HostIp: '0.0.0.0', HostPort: '9999' }]; }],
+        ['different network', p => { p[1].NetworkSettings.Networks['thirasara-phase4-local'].NetworkID = 'other'; }],
+        ['extra network', p => { p[1].NetworkSettings.Networks.bridge = {}; }],
+        ['hosted database routing', p => { p[1].Config.Env[0] = 'PGRST_DB_URI=postgres://authenticator:p@hosted.example/postgres'; }],
+        ['wrong database name', p => { p[1].Config.Env[0] = p[1].Config.Env[0].replace('/postgres', '/other'); }],
+        ['mismatched JWT secret', p => { p[1].Config.Env[1] = 'PGRST_JWT_SECRET=other'; }],
+        ['mismatched JWKS', p => { p[1].Config.Env[1] = 'PGRST_JWT_SECRET={"keys":[{"kty":"oct","k":"b3RoZXI"}]}'; }],
+        ['invalid JWKS', p => { p[1].Config.Env[1] = 'PGRST_JWT_SECRET={"keys":null}'; }],
+        ['missing credential', p => { p[0].Config.Env = ['JWT_SECRET=local-test-secret']; }],
+    ])('rejects %s before connections or fixture writes', (_label, mutate) => {
+        const snapshots = pair();
+        mutate(snapshots);
+        expect(() => validateContainers(snapshots)).toThrow(/isolated/i);
+    });
+
+    test('accepts exact unlinked CLI project configuration', () => {
+        expect(() => validateWorkdir('project_id = "thirasara-phase4-c"\n', false)).not.toThrow();
+    });
+    test.each([
+        ['project_id = "live"', false],
+        ['project_id = "thirasara-phase4-c"', true],
+    ])('rejects wrong or remote-linked workdir', (config, linked) => {
+        expect(() => validateWorkdir(config, linked)).toThrow(/isolated/i);
+    });
+    test('accepts exact marker and two-version ledger', () => {
+        expect(() => validateDatabase(identity())).not.toThrow();
+    });
+    test.each([
+        { marker: false }, { database: 'live' }, { user: 'authenticator' }, { major: 16 },
+        { versions: [] }, { versions: ['20261030045356', '20261030045416', 'extra'] },
+    ])('rejects unexpected database identity %j', change => {
+        expect(() => validateDatabase({ ...identity(), ...change })).toThrow(/isolated/i);
+    });
+});
diff --git "a/D:\\CSC3213_20_Group_E\\backend-node\\tests\\integrationNetworkGuard.test.js" "b/D:\\CSC3213_20_Group_E\\backend-node\\tests\\integrationNetworkGuard.test.js"
