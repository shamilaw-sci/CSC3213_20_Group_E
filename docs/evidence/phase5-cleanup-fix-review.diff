diff --git a/backend-node/utils/propertyImageCleanup.js b/backend-node/utils/propertyImageCleanup.js
new file mode 100644
index 0000000..e2f1f58
--- /dev/null
+++ b/backend-node/utils/propertyImageCleanup.js
@@ -0,0 +1,84 @@
+const defaultLogger = require('./logger');
+const PUBLIC_PROPERTIES_PREFIX = '/storage/v1/object/public/properties/';
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+
+function configuredOrigin(value) {
+    const url = new URL(value);
+    if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password || url.search || url.hash
+        || !['', '/'].includes(url.pathname)) throw new Error('Invalid configured Storage origin.');
+    return url.origin;
+}
+
+// Validate the original spelling before URL can normalize dot segments or backslashes.
+function managedPropertyPath(value, sellerId, supabaseUrl) {
+    if (typeof value !== 'string' || !UUID.test(sellerId) || /[\\\x00-\x20\x7f]/.test(value)) return null;
+    try {
+        const origin = configuredOrigin(supabaseUrl);
+        const rawPath = /^https?:\/\/[^/?#]+(\/[^?#]*)$/.exec(value)?.[1];
+        if (!rawPath?.startsWith(PUBLIC_PROPERTIES_PREFIX)) return null;
+        const url = new URL(value);
+        if (url.origin !== origin || url.username || url.password || url.search || url.hash) return null;
+        const parts = rawPath.slice(PUBLIC_PROPERTIES_PREFIX.length).split('/').map(part => decodeURIComponent(part));
+        if (parts.length < 2 || parts[0] !== sellerId || parts.some(part => !part || part === '.' || part === '..'
+            || /[\\/%\x00-\x1f\x7f]/.test(part))) return null;
+        return parts.join('/');
+    } catch { return null; }
+}
+
+function references(row) {
+    const values = [];
+    if (Array.isArray(row.images)) values.push(...row.images);
+    else if (row.images != null) values.push(row.images);
+    if (Array.isArray(row.virtual_tours)) values.push(...row.virtual_tours.map(tour => tour?.url));
+    else if (row.virtual_tours != null) values.push(undefined);
+    return values;
+}
+
+async function cleanupPropertyImages(client, listing, { supabaseUrl = process.env.SUPABASE_URL,
+    logger = defaultLogger, pageSize = 500 } = {}) {
+    const candidates = new Set();
+    let skippedReferenceCount = 0;
+    for (const value of references(listing)) {
+        const path = managedPropertyPath(value, listing.seller_id, supabaseUrl);
+        if (path) candidates.add(path);
+        else skippedReferenceCount++;
+    }
+    if (skippedReferenceCount) logger.warn('Property image cleanup skipped unmanaged references.', { event: 'property_image_cleanup_skipped_references',
+        listingId: listing.id, sellerId: listing.seller_id, skippedReferenceCount });
+    if (!candidates.size) return;
+
+    let stage = 'reference_lookup';
+    let managedPaths = [...candidates];
+    try {
+        if (!Number.isInteger(pageSize) || pageSize < 1) throw new Error('Invalid reference page size.');
+        const referenced = new Set();
+        let offset = 0;
+        // Continue until an empty page, including when the server caps pages below our requested size.
+        for (;;) {
+            const { data, error } = await client.from('properties').select('id,images,virtual_tours')
+                .order('id', { ascending: true }).range(offset, offset + pageSize - 1);
+            if (error || !Array.isArray(data)) throw new Error('Reference lookup failed.');
+            if (!data.length) break;
+            for (const row of data) {
+                for (const value of references(row)) {
+                    const path = managedPropertyPath(value, listing.seller_id, supabaseUrl);
+                    if (path && candidates.has(path)) referenced.add(path);
+                }
+            }
+            offset += data.length;
+        }
+        managedPaths = managedPaths.filter(path => !referenced.has(path));
+        if (!managedPaths.length) return;
+        stage = 'storage_remove';
+        const { error } = await client.storage.from('properties').remove(managedPaths);
+        if (error) throw new Error('Storage removal failed.');
+    } catch {
+        // DB deletion has committed. These exact managed paths support manual recovery; this is not a durable job.
+        logger.error('Property image cleanup requires recovery after database deletion.', { event: 'property_image_cleanup_recovery_required', stage,
+            listingId: listing.id, sellerId: listing.seller_id, managedPaths });
+        throw new Error('Listing image cleanup failed after database deletion.');
+    }
+}
+
+module.exports = { cleanupPropertyImages, managedPropertyPath };
+
diff --git a/backend-node/tests/propertyImageCleanup.test.js b/backend-node/tests/propertyImageCleanup.test.js
new file mode 100644
index 0000000..96b3191
--- /dev/null
+++ b/backend-node/tests/propertyImageCleanup.test.js
@@ -0,0 +1,97 @@
+const { cleanupPropertyImages, managedPropertyPath } = require('../utils/propertyImageCleanup');
+const origin = 'https://local-project.supabase.co';
+const owner = '11111111-1111-4111-8111-111111111111';
+const other = '22222222-2222-4222-8222-222222222222';
+const path = `${owner}/photo.png`;
+const url = name => `${origin}/storage/v1/object/public/properties/${owner}/${name}`;
+const listing = extra => ({ id: '33333333-3333-4333-8333-333333333333', seller_id: owner, images: [url('photo.png')], virtual_tours: [], ...extra });
+function harness(pages = [[]]) {
+    const remove = jest.fn().mockResolvedValue({ data: [], error: null });
+    const range = jest.fn();
+    pages.forEach(data => range.mockResolvedValueOnce({ data, error: null }));
+    const order = jest.fn(() => ({ range }));
+    const select = jest.fn(() => ({ order }));
+    const storageFrom = jest.fn(() => ({ remove }));
+    const client = { from: jest.fn(() => ({ select })), storage: { from: storageFrom } };
+    const logger = { warn: jest.fn(), error: jest.fn() };
+    const clean = row => cleanupPropertyImages(client, row, { supabaseUrl: origin, logger, pageSize: 2 });
+    return { client, remove, range, order, select, logger, clean };
+}
+
+test('accepts only exact configured public properties owner paths', () => {
+    expect(managedPropertyPath(url('photo.png'), owner, origin)).toBe(path);
+    expect(managedPropertyPath(url('room%20one.png'), owner, origin)).toBe(`${owner}/room one.png`);
+});
+test.each([
+    'https://foreign.example/storage/v1/object/public/properties/OWNER/photo.png',
+    `${origin}/storage/v1/object/public/properties/${other}/photo.png`,
+    `${origin}/storage/v1/object/sign/properties/OWNER/photo.png?token=credential`,
+    `${origin}/storage/v1/object/public/other/OWNER/photo.png`,
+    `https://credential@local-project.supabase.co/storage/v1/object/public/properties/OWNER/photo.png`,
+    `${origin}/storage/v1/object/public/properties/OWNER/../photo.png`,
+    `${origin}/storage/v1/object/public/properties/OWNER/%2e%2e/photo.png`,
+    `${origin}/storage/v1/object/public/properties/OWNER/%252e%252e/photo.png`,
+    `${origin}/storage/v1/object/public/properties/OWNER/a%2f..%2fphoto.png`,
+    `${origin}/storage/v1/object/public/properties/OWNER/a%5cphoto.png`,
+    `${origin}/storage/v1/object/public/properties/OWNER/%zz.png`,
+    `${origin}/storage/v1/object/public/properties/OWNER/%00.png`,
+    `${origin}/storage/v1/object/public/properties/OWNER/photo.png?token=secret`,
+    `${origin}/storage/v1/object/public/properties/OWNER/photo.png#fragment`,
+    'not-a-url', null, {},
+])('rejects unmanaged or malformed path %j', value => {
+    expect(managedPropertyPath(typeof value === 'string' ? value.replaceAll('OWNER', owner) : value, owner, origin)).toBeNull();
+});
+test('rejects malformed owner and configured credentials', () => {
+    expect(managedPropertyPath(url('photo.png'), 'wrong', origin)).toBeNull();
+    expect(managedPropertyPath(url('photo.png'), owner, 'https://user@local-project.supabase.co')).toBeNull();
+});
+test('empty and unmanaged-only records do not query or remove', async () => {
+    const h = harness();
+    await h.clean(listing({ images: [], virtual_tours: null }));
+    await h.clean(listing({ images: ['https://foreign.example/private?secret=x'], virtual_tours: [{ url: 42 }] }));
+    expect(h.client.from).not.toHaveBeenCalled(); expect(h.remove).not.toHaveBeenCalled();
+    expect(h.logger.warn).toHaveBeenCalledWith(expect.any(String), expect.objectContaining({ skippedReferenceCount: 2 }));
+    expect(JSON.stringify(h.logger.warn.mock.calls)).not.toContain('secret');
+});
+test('deduplicates photos and tours and awaits removal', async () => {
+    const h = harness();
+    let finish;
+    h.remove.mockImplementation(() => new Promise(resolve => { finish = resolve; }));
+    let completed = false;
+    const pending = h.clean(listing({ images: [url('photo.png'), url('photo.png')], virtual_tours: [{ url: url('tour.png') }, { url: url('photo.png') }] })).then(() => { completed = true; });
+    await new Promise(resolve => setImmediate(resolve));
+    expect(completed).toBe(false);
+    expect(h.remove).toHaveBeenCalledWith([path, `${owner}/tour.png`]);
+    finish({ error: null }); await pending; expect(completed).toBe(true);
+});
+test('scans every deterministic page even when a server returns fewer rows than requested', async () => {
+    const h = harness([[{ id: 'a', images: [], virtual_tours: [] }],
+        [{ id: 'b', images: [], virtual_tours: [{ url: url('photo.png') }] }], []]);
+    await h.clean(listing({ images: [url('photo.png'), url('unshared.png')] }));
+    expect(h.range.mock.calls).toEqual([[0, 1], [1, 2], [2, 3]]);
+    expect(h.order).toHaveBeenCalledWith('id', { ascending: true });
+    expect(h.remove).toHaveBeenCalledWith([`${owner}/unshared.png`]);
+});
+test('preserves all paths when a remaining listing still references them', async () => {
+    const h = harness([[{ images: [url('photo.png')] }], []]);
+    await h.clean(listing()); expect(h.remove).not.toHaveBeenCalled();
+});
+test.each(['lookup', 'remove', 'throw'])('fails with safe structured recovery after %s failure', async stage => {
+    const h = harness();
+    const error = { message: 'upstream credential must not be logged' };
+    if (stage === 'lookup') h.range.mockReset().mockResolvedValue({ error });
+    else if (stage === 'remove') h.remove.mockResolvedValue({ error });
+    else h.remove.mockRejectedValue(error);
+    await expect(h.clean(listing())).rejects.toThrow(/image cleanup failed/i);
+    if (stage === 'lookup') expect(h.remove).not.toHaveBeenCalled();
+    expect(h.logger.error).toHaveBeenCalledWith(expect.any(String), expect.objectContaining({
+        event: 'property_image_cleanup_recovery_required', listingId: listing().id, sellerId: owner, managedPaths: [path],
+    }));
+    expect(JSON.stringify(h.logger.error.mock.calls)).not.toContain('credential');
+});
+test.each([null, {}, 'not rows'])('fails closed on nonarray reference success %j', async data => {
+    const h = harness();
+    h.range.mockReset().mockResolvedValue({ data, error: null });
+    await expect(h.clean(listing())).rejects.toThrow(/image cleanup failed/i);
+    expect(h.remove).not.toHaveBeenCalled();
+});
diff --git a/backend-node/tests/listingDeletionCleanup.test.js b/backend-node/tests/listingDeletionCleanup.test.js
new file mode 100644
index 0000000..6df57e2
--- /dev/null
+++ b/backend-node/tests/listingDeletionCleanup.test.js
@@ -0,0 +1,49 @@
+jest.mock('../config/supabase', () => ({ from: jest.fn() }));
+jest.mock('../utils/propertyImageCleanup', () => ({ cleanupPropertyImages: jest.fn() }), { virtual: true });
+const supabase = require('../config/supabase');
+const { cleanupPropertyImages } = require('../utils/propertyImageCleanup');
+const seller = require('../repositories/propertyRepository');
+const admin = require('../repositories/adminRepository');
+const row = { id: 'listing', seller_id: 'owner', images: ['managed-photo'], virtual_tours: [{ url: 'managed-tour' }] };
+let query;
+beforeEach(() => {
+    jest.clearAllMocks();
+    query = { delete: jest.fn().mockReturnThis(), eq: jest.fn().mockReturnThis(),
+        select: jest.fn().mockResolvedValue({ data: [row], error: null }) };
+    supabase.from.mockReturnValue(query);
+    cleanupPropertyImages.mockResolvedValue(undefined);
+});
+const cases = [
+    ['seller', () => seller.deleteMyProperty('listing', 'owner'), true],
+    ['admin', () => admin.deleteListing('listing'), undefined],
+];
+test.each(cases)('%s atomically deletes then awaits cleanup with deleted metadata', async (kind, remove, result) => {
+    let finish;
+    cleanupPropertyImages.mockImplementation(() => new Promise(resolve => { finish = resolve; }));
+    let completed = false;
+    const pending = remove().then(value => { completed = true; return value; });
+    await new Promise(resolve => setImmediate(resolve));
+    expect(query.delete).toHaveBeenCalledTimes(1);
+    expect(query.select).toHaveBeenCalledWith('id,seller_id,images,virtual_tours');
+    expect(query.eq.mock.calls).toEqual(kind === 'seller' ? [['id', 'listing'], ['seller_id', 'owner']] : [['id', 'listing']]);
+    expect(cleanupPropertyImages).toHaveBeenCalledWith(supabase, row);
+    expect(query.select.mock.invocationCallOrder[0]).toBeLessThan(cleanupPropertyImages.mock.invocationCallOrder[0]);
+    expect(completed).toBe(false);
+    finish(); expect(await pending).toBe(result);
+});
+test.each(cases)('%s missing row retains its existing result and never cleans files', async (kind, remove) => {
+    query.select.mockResolvedValue({ data: [], error: null });
+    expect(await remove()).toBe(kind === 'seller' ? false : undefined);
+    expect(cleanupPropertyImages).not.toHaveBeenCalled();
+});
+test.each(cases)('%s DB failure never removes files', async (_kind, remove) => {
+    const failure = new Error('foreign key failure');
+    query.select.mockResolvedValue({ data: null, error: failure });
+    await expect(remove()).rejects.toBe(failure);
+    expect(cleanupPropertyImages).not.toHaveBeenCalled();
+});
+test.each(cases)('%s cleanup failure cannot return success', async (_kind, remove) => {
+    const failure = new Error('Storage unavailable after DB deletion');
+    cleanupPropertyImages.mockRejectedValue(failure);
+    await expect(remove()).rejects.toBe(failure);
+});
diff --git a/backend-node/integration/storage.integration.cjs b/backend-node/integration/storage.integration.cjs
new file mode 100644
index 0000000..c8d91fc
--- /dev/null
+++ b/backend-node/integration/storage.integration.cjs
@@ -0,0 +1,257 @@
+const { randomUUID, createHash } = require('node:crypto');
+const { setTimeout: delay } = require('node:timers/promises');
+const request = require('supertest');
+const bcrypt = require('bcryptjs');
+const { Client } = require('pg');
+const { identitySql, validateDatabase } = require('./local-stack.cjs');
+const { allowedAppPorts } = require('./network-policy.cjs');
+const { fileManifest } = require('./storage-state.cjs');
+const { injectSecondUploadFailure, clearStorageFault, observeSuccessfulUploads,
+    clearUploadObserver, storageFaultEvidence } = require('./storage-network.cjs');
+const storage = require('../config/supabase').storage.from('properties');
+const app = require('../server');
+const png = Buffer.from('iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+a6CkAAAAASUVORK5CYII=', 'base64');
+const sha256 = bytes => createHash('sha256').update(bytes).digest('hex');
+const run = randomUUID(), password = 'Storage-fixture-only-123!';
+const roles = ['SELLER', 'AGENT', 'BUYER', 'ADMIN', 'OTHER_SELLER'];
+const users = Object.fromEntries(roles.map(key => [key, { id: randomUUID(), role: key === 'OTHER_SELLER' ? 'SELLER' : key,
+    email: `${run}-${key.toLowerCase()}@example.test` }]));
+const ids = Object.values(users).map(user => user.id), sessions = {};
+const db = new Client(JSON.parse(process.env.PHASE5_DATABASE));
+let connected = false, server, port;
+const call = (role, method, path) => {
+    const req = request(server)[method](path);
+    return role ? req.set('Cookie', sessions[role]) : req;
+};
+const payload = extra => ({ type: 'House', title: `Storage ${run}`, description: 'Isolated synthetic image test property.',
+    price: '1000000', latitude: '7', longitude: '80', ...extra });
+const upload = (role, { fields = {}, photos = 1, tour = false } = {}) => {
+    let req = call(role, 'post', '/api/properties');
+    for (const [key, value] of Object.entries(payload(fields))) req = req.field(key, value);
+    for (let n = 0; n < photos; n++) req = req.attach('images', png, { filename: `fixture-${n}.png`, contentType: 'image/png' });
+    if (tour) req = req.field('virtualTourMetadata', JSON.stringify([{ room: 'Bedroom' }]))
+        .attach('virtualTours', png, { filename: 'panorama.png', contentType: 'image/png' });
+    return req;
+};
+const objects = async () => (await db.query("SELECT name,metadata FROM storage.objects WHERE bucket_id='properties' AND split_part(name,'/',1)=ANY($1::text[]) ORDER BY name", [ids])).rows;
+const names = async () => (await objects()).map(object => object.name);
+const rows = async () => (await db.query('SELECT id FROM public.properties WHERE seller_id=ANY($1::uuid[]) ORDER BY id', [ids])).rows.map(row => row.id);
+const files = () => fileManifest(process.env.PHASE5_STORAGE_CONTAINER).filter(file => file.path.split('/').some(part => ids.includes(part)));
+async function eventually(check, timeout = 8000) {
+    const deadline = Date.now() + timeout;
+    do { if (await check()) return true; await delay(150); } while (Date.now() < deadline);
+    return false;
+}
+const pathFromUrl = value => {
+    const url = new URL(value);
+    expect(url.origin).toBe('http://127.0.0.1:58321');
+    const prefix = '/storage/v1/object/public/properties/';
+    expect(url.pathname.startsWith(prefix)).toBe(true);
+    const path = decodeURIComponent(url.pathname.slice(prefix.length));
+    expect(ids).toContain(path.split('/')[0]);
+    return path;
+};
+async function verifyImage(url, owner) {
+    const path = pathFromUrl(url);
+    expect(path.split('/')[0]).toBe(users[owner].id);
+    const metadata = (await objects()).find(object => object.name === path)?.metadata;
+    expect(metadata).toMatchObject({ mimetype: 'image/png', size: png.length });
+    // Public bucket: prove bytes via unauthenticated public transport, not a private-file rule.
+    const response = await fetch(url);
+    expect(response.status).toBe(200);
+    expect(response.headers.get('content-type')).toMatch(/^image\/png/);
+    expect(sha256(Buffer.from(await response.arrayBuffer()))).toBe(sha256(png));
+    expect(files().some(file => file.path.split('/').includes(users[owner].id) && file.sha256 === sha256(png))).toBe(true);
+    return path;
+}
+function proveSuccessfulUpload(role, evidence) {
+    observeSuccessfulUploads(users[role].id, async transfer => {
+        expect(transfer.owner).toBe(users[role].id);
+        expect(transfer.path.startsWith(`${users[role].id}/`)).toBe(true);
+        const stored = await db.query("SELECT name,metadata FROM storage.objects WHERE bucket_id='properties' AND name=$1", [transfer.path]);
+        expect(stored.rows).toHaveLength(1);
+        expect(stored.rows[0].metadata).toMatchObject({ mimetype: 'image/png', size: png.length });
+        const physical = files().filter(file => file.path.includes(`/properties/${transfer.path}/`)
+            || file.path.endsWith(`/properties/${transfer.path}`));
+        expect(physical.some(file => file.sha256 === sha256(png) && file.size === png.length)).toBe(true);
+        evidence.push(transfer);
+    });
+}
+
+beforeAll(async () => {
+    server = await new Promise((resolve, reject) => { const listener = app.listen(0, '127.0.0.1', () => resolve(listener)); listener.once('error', reject); });
+    port = server.address().port;
+    allowedAppPorts.add(port);
+    await db.connect(); connected = true;
+    validateDatabase((await db.query(identitySql)).rows[0]);
+    const hash = await bcrypt.hash(password, 10);
+    for (const [key, user] of Object.entries(users)) {
+        await db.query('INSERT INTO public.users(id,name,email,password_hash,role) VALUES($1,$2,$3,$4,$5)',
+            [user.id, `Storage ${key}`, user.email, hash, user.role]);
+        const response = await request(server).post(key === 'ADMIN' ? '/api/admin/login' : '/api/auth/login').send({ email: user.email, password });
+        expect(response.status).toBe(200);
+        sessions[key] = response.headers['set-cookie'][0].split(';')[0];
+    }
+});
+
+afterAll(async () => {
+    clearStorageFault();
+    clearUploadObserver();
+    try {
+        if (connected) {
+            validateDatabase((await db.query(identitySql)).rows[0]);
+            const paths = await names();
+            if (paths.length) { const removed = await storage.remove(paths); if (removed.error) throw new Error('Exact Storage fixture cleanup failed.'); }
+            expect(await eventually(async () => (await names()).length === 0 && files().length === 0)).toBe(true);
+            await db.query('DELETE FROM public.properties WHERE seller_id=ANY($1::uuid[])', [ids]);
+            expect(await rows()).toEqual([]);
+            await db.query('DELETE FROM public.users WHERE id=ANY($1::uuid[]) AND email=ANY($2::text[])', [ids, Object.values(users).map(user => user.email)]);
+            expect((await db.query('SELECT id FROM public.users WHERE id=ANY($1::uuid[])', [ids])).rows).toEqual([]);
+            console.log('Storage fixture cleanup verified: actual Storage API removed exact owned objects/files before own properties/users.');
+        }
+    } finally {
+        try { await db.end(); }
+        finally { try { if (server?.listening) await new Promise((resolve, reject) => server.close(error => error ? reject(error) : resolve())); }
+            finally { allowedAppPorts.delete(port); } }
+    }
+});
+
+describe('Real local image/Storage integration', () => {
+    test.each(['SELLER', 'AGENT'])('%s image creation persists URL, metadata and exact public bytes', async role => {
+        const response = await upload(role);
+        expect(response.status).toBe(201);
+        expect(response.body.property).toMatchObject({ seller_id: users[role].id, status: 'pending', payment_status: 'Unpaid' });
+        expect(response.body.property.images).toHaveLength(1);
+        await verifyImage(response.body.property.images[0], role);
+    });
+
+    test('multiple real photos and tour preserve URL/room associations', async () => {
