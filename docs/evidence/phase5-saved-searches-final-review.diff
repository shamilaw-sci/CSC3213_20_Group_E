+        const geo = (await db.query('SELECT extensions.ST_SRID(boundary) AS srid, extensions.ST_IsValid(boundary) AS valid, extensions.ST_AsText(boundary) AS wkt FROM public.properties WHERE id=$1', [id])).rows[0];
