+import React from 'react';
+import { act, cleanup, fireEvent, render, screen, waitFor, within } from '@testing-library/react';
+import { MemoryRouter, Route, Routes } from 'react-router-dom';
+import { Toaster, toast } from 'react-hot-toast';
+import { afterEach, beforeEach, describe, expect, test, vi } from 'vitest';
+import MyProperties from './MyProperties';
+import { UserAuthProvider } from '../context/UserAuthContext';
+
+const api = vi.hoisted(() => ({ get: vi.fn(), post: vi.fn(), delete: vi.fn() }));
+const payment = vi.hoisted(() => ({ triggerPayment: vi.fn() }));
+vi.mock('../context/api', () => ({ default: api }));
+vi.mock('../hooks/usePayhere', () => ({ usePayhere: () => payment }));
+vi.mock('../components/layout/Navbar', () => ({ default: () => null }));
+vi.mock('../components/layout/Footer', () => ({ default: () => null }));
+vi.mock('framer-motion', () => ({ m: { div: ({ children, className }) => <div className={className}>{children}</div> } }));
+
+const seller = { id: 'fixture-seller', name: 'Fixture seller', role: 'SELLER' };
+const property = (id, status = 'pending', paymentStatus = 'Paid') => ({
+  id, title: `Fixture ${id}`, seller_id: seller.id, status, payment_status: paymentStatus,
+  price: 1000, city: 'Colombo', district: 'Colombo', images: [],
+});
+const fixtures = [
+  property('unpaid-pending', 'pending', 'Unpaid'),
+  property('unpaid-approved', 'approved', 'Unpaid'),
+  property('paid-pending'),
+  property('paid-approved', 'approved'),
+  property('paid-rejected', 'rejected', 'paid'),
+];
+
+function show() {
+  return render(<MemoryRouter initialEntries={['/my-properties']}>
+    <UserAuthProvider>
+      <Toaster />
+      <Routes><Route path="/my-properties" element={<MyProperties />} /></Routes>
+    </UserAuthProvider>
+  </MemoryRouter>);
+}
+
+const card = (id) => within(screen.getByRole('heading', { name: `Fixture ${id}` }).closest('.group'));
+const listedTitles = () => screen.queryAllByRole('heading', { level: 3 }).map(node => node.textContent);
+
+beforeEach(() => {
+  vi.resetAllMocks();
+  vi.stubGlobal('matchMedia', vi.fn((media) => ({
+    matches: false, media, onchange: null,
+    addEventListener: vi.fn(), removeEventListener: vi.fn(),
+    addListener: vi.fn(), removeListener: vi.fn(), dispatchEvent: vi.fn(),
+  })));
+  vi.spyOn(window, 'confirm').mockReturnValue(false);
+  api.get.mockImplementation(async (path) => {
+    if (path === '/auth/me') return { data: { user: seller } };
+    if (path === '/properties/my-listings') return { data: { properties: fixtures } };
+    throw new Error(`Unexpected HTTP request: ${path}`);
+  });
+  api.delete.mockResolvedValue({ data: { message: 'Property deleted successfully' } });
+  payment.triggerPayment.mockResolvedValue(undefined);
+});
+
+afterEach(() => {
+  cleanup();
+  toast.remove();
+  vi.restoreAllMocks();
+  vi.unstubAllGlobals();
+});
+
+describe('Actual MyProperties with auth provider and controlled HTTP', () => {
+  test('loading does not prematurely display the empty state', async () => {
+    let finish;
+    api.get.mockImplementation((path) => path === '/auth/me'
+      ? Promise.resolve({ data: { user: seller } })
+      : new Promise(resolve => { finish = resolve; }));
+    const { container } = show();
+    await screen.findByRole('heading', { name: 'Manage My Listings' });
+    expect(container.querySelector('.animate-spin')).toBeInTheDocument();
+    expect(screen.queryByText('No listings found')).not.toBeInTheDocument();
+    await act(async () => finish({ data: { properties: [] } }));
+    expect(await screen.findByText('No listings found')).toBeInTheDocument();
+    expect(container.querySelector('.animate-spin')).not.toBeInTheDocument();
+  });
+
+  test('an empty response offers the first-listing action', async () => {
+    api.get.mockImplementation(async (path) => path === '/auth/me'
+      ? { data: { user: seller } } : { data: { properties: [] } });
+    show();
+    expect(await screen.findByText('No listings found')).toBeInTheDocument();
+    expect(screen.getByRole('button', { name: '+ Add Your First Property' })).toBeInTheDocument();
+  });
+
+  test('load failure displays feedback and does not invent listing cards', async () => {
+    vi.spyOn(console, 'error').mockImplementation(() => {});
+    api.get.mockImplementation(async (path) => {
+      if (path === '/auth/me') return { data: { user: seller } };
+      throw new Error('Controlled load failure');
+    });
+    show();
+    expect(await screen.findByText('Failed to load properties')).toBeInTheDocument();
+    expect(screen.getByText('No listings found')).toBeInTheDocument();
+    expect(screen.queryByRole('heading', { name: /^Fixture / })).not.toBeInTheDocument();
+  });
+
+  test('unpaid records are effective drafts while paid moderation states stay distinct', async () => {
+    show();
+    await screen.findByRole('heading', { name: 'Fixture paid-approved' });
+    expect(listedTitles()).toEqual(fixtures.map(item => item.title));
+    expect(card('unpaid-approved').getByText('Drafts (Unpaid)')).toBeInTheDocument();
+    expect(card('unpaid-approved').getByText('Payment Required to Submit')).toBeInTheDocument();
+    expect(card('paid-approved').queryByRole('button', { name: /Pay Rs/ })).not.toBeInTheDocument();
+    for (const [tab, titles] of [
+      ['Drafts (Unpaid)', ['Fixture unpaid-pending', 'Fixture unpaid-approved']],
+      ['Pending Review', ['Fixture paid-pending']],
+      ['Live & Approved', ['Fixture paid-approved']],
+      ['Needs Changes', ['Fixture paid-rejected']],
+      ['All Listings', fixtures.map(item => item.title)],
+    ]) {
+      fireEvent.click(screen.getByRole('button', { name: new RegExp(tab.replace(/[()]/g, '\\$&')) }));
+      expect(listedTitles()).toEqual(titles);
+    }
+    expect(payment.triggerPayment).not.toHaveBeenCalled();
+  });
+
+  test('canceling deletion leaves both API and listing untouched', async () => {
+    show();
+    await screen.findByRole('heading', { name: 'Fixture paid-pending' });
+    fireEvent.click(card('paid-pending').getByTitle('Delete Listing'));
+    expect(window.confirm).toHaveBeenCalledWith('Are you sure you want to delete this listing?');
+    expect(api.delete).not.toHaveBeenCalled();
+    expect(screen.getByRole('heading', { name: 'Fixture paid-pending' })).toBeInTheDocument();
+  });
+
+  test('successful deletion removes only the selected listing and updates the draft filter', async () => {
+    window.confirm.mockReturnValue(true);
+    show();
+    await screen.findByRole('heading', { name: 'Fixture unpaid-pending' });
+    fireEvent.click(card('unpaid-pending').getByTitle('Delete Listing'));
+    expect(await screen.findByText('Listing deleted successfully')).toBeInTheDocument();
+    expect(api.delete).toHaveBeenCalledExactlyOnceWith('/properties/my-listings/unpaid-pending');
+    expect(listedTitles()).toEqual(fixtures.filter(item => item.id !== 'unpaid-pending').map(item => item.title));
+    fireEvent.click(screen.getByRole('button', { name: /Drafts \(Unpaid\)/ }));
+    expect(listedTitles()).toEqual(['Fixture unpaid-approved']);
+  });
+
+  test('failed deletion retains the selected listing and shows server failure feedback', async () => {
+    window.confirm.mockReturnValue(true);
+    api.delete.mockRejectedValueOnce(new Error('Controlled delete failure'));
+    show();
+    await screen.findByRole('heading', { name: 'Fixture paid-approved' });
+    fireEvent.click(card('paid-approved').getByTitle('Delete Listing'));
+    expect(await screen.findByText('Failed to delete property.')).toBeInTheDocument();
+    expect(api.delete).toHaveBeenCalledExactlyOnceWith('/properties/my-listings/paid-approved');
+    expect(listedTitles()).toEqual(fixtures.map(item => item.title));
+    await waitFor(() => expect(screen.getByRole('heading', { name: 'Fixture paid-approved' })).toBeInTheDocument());
+  });
+});
diff --git a/frontend-react/src/pages/ProfileSettings.integration.test.jsx b/frontend-react/src/pages/ProfileSettings.integration.test.jsx
new file mode 100644
index 0000000..dd5d359
--- /dev/null
+++ b/frontend-react/src/pages/ProfileSettings.integration.test.jsx
@@ -0,0 +1,113 @@
+import { act, cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react';
+import { afterEach, beforeEach, expect, test, vi } from 'vitest';
+import { MemoryRouter, useLocation } from 'react-router-dom';
+import toast from 'react-hot-toast';
+import ProfileSettings from './ProfileSettings';
+import api from '../context/api';
+
+const auth = vi.hoisted(() => ({ user: { id: 'u1', name: 'Tester', role: 'SELLER' }, login: vi.fn() }));
+vi.mock('../context/UserAuthContext', () => ({ useAuth: () => auth }));
+vi.mock('../context/ThemeProvider', () => ({ useTheme: () => ({ theme: 'light', changeTheme: vi.fn() }) }));
+vi.mock('../context/api', () => ({ default: { get: vi.fn(), patch: vi.fn(), delete: vi.fn() } }));
+vi.mock('react-hot-toast', () => ({ default: { success: vi.fn(), error: vi.fn() } }));
+vi.mock('../components/layout/Navbar', () => ({ default: () => null }));
+vi.mock('../components/layout/Footer', () => ({ default: () => null }));
+vi.mock('../components/profile/PreferencesSettings', () => ({ default: () => null }));
+vi.mock('../components/profile/AgentProfileSettings', () => ({ default: () => null }));
+vi.mock('../components/profile/SecuritySettings', () => ({ default: () => null }));
+vi.mock('framer-motion', () => ({
+    AnimatePresence: ({ children }) => children,
+    m: { div: ({ children, initial: _initial, animate: _animate, exit: _exit, layoutId: _layoutId, ...props }) => <div {...props}>{children}</div> },
+}));
+
+const savedSearch = {
+    id: 's1', title: 'Saved Kandy', email_alerts_enabled: true,
+    polygon: { type: 'Polygon', coordinates: [[[80.6, 7.2], [80.7, 7.2], [80.6, 7.3], [80.6, 7.2]]] },
+    beds: 0, baths: 0, property_type: null,
+    filters: {
+        version: 1, searchTerm: 'Kandy', listingType: 'Rent', minPrice: 0, maxPrice: 50000,
+        beds: 0, baths: 0, exactMatch: true, has360Tour: true,
+        propTypes: { House: true, Land: false, Apartment: true, Villa: false },
+    },
+};
+
+beforeEach(() => {
+    vi.resetAllMocks();
+    vi.spyOn(console, 'error').mockImplementation(() => {});
+    api.get.mockImplementation(async url => ({ data: url === '/saved-searches' ? { savedSearches: [savedSearch] } : {} }));
+});
+afterEach(() => { cleanup(); vi.restoreAllMocks(); });
+
+function RouteEvidence() {
+    const location = useLocation();
+    return <output data-testid="route">{JSON.stringify({ pathname: location.pathname, state: location.state })}</output>;
+}
+async function renderSearches() {
+    render(<MemoryRouter initialEntries={['/profile?tab=searches']}><ProfileSettings /><RouteEvidence /></MemoryRouter>);
+    expect(await screen.findByText('Saved Kandy')).toBeTruthy();
+    expect(api.get).toHaveBeenCalledWith('/saved-searches');
+}
+function toggle() {
+    fireEvent.click(screen.getByRole('button', { name: 'Toggle email alerts for this saved search' }));
+}
+
+test('turns alerts off and back on with successful persisted requests', async () => {
+    api.patch.mockResolvedValue({ data: {} });
+    await renderSearches();
+    expect(screen.getByText('Email alerts on')).toBeTruthy();
+    toggle();
+    await waitFor(() => expect(api.patch).toHaveBeenNthCalledWith(1, '/saved-searches/s1/alerts', { emailAlertsEnabled: false }));
+    expect(screen.getByText('Email alerts off')).toBeTruthy();
+    toggle();
+    await waitFor(() => expect(api.patch).toHaveBeenNthCalledWith(2, '/saved-searches/s1/alerts', { emailAlertsEnabled: true }));
+    expect(screen.getByText('Email alerts on')).toBeTruthy();
+    expect(api.patch).toHaveBeenCalledTimes(2);
+});
+
+test.each([true, false])('rolls back the visible optimistic toggle when rejected (initial alerts %s)', async enabled => {
+    api.get.mockImplementation(async url => ({ data: url === '/saved-searches' ? { savedSearches: [{ ...savedSearch, email_alerts_enabled: enabled }] } : {} }));
+    let rejectToggle;
+    api.patch.mockReturnValue(new Promise((_resolve, reject) => { rejectToggle = reject; }));
+    await renderSearches();
+    toggle();
+    expect(screen.getByText(enabled ? 'Email alerts off' : 'Email alerts on')).toBeTruthy();
+    expect(api.patch).toHaveBeenCalledExactlyOnceWith('/saved-searches/s1/alerts', { emailAlertsEnabled: !enabled });
+    await act(async () => { rejectToggle(new Error('Preference unavailable')); });
+    expect(screen.getByText(enabled ? 'Email alerts on' : 'Email alerts off')).toBeTruthy();
+    expect(screen.getByText('Saved Kandy')).toBeTruthy();
+    expect(toast.success).not.toHaveBeenCalled();
+});
+
+test('removes the saved search only after delete succeeds', async () => {
+    let resolveDelete;
+    api.delete.mockReturnValue(new Promise(resolve => { resolveDelete = resolve; }));
+    await renderSearches();
+    fireEvent.click(screen.getByTitle('Delete search'));
+    expect(api.delete).toHaveBeenCalledExactlyOnceWith('/saved-searches/s1');
+    expect(screen.getByText('Saved Kandy')).toBeTruthy();
+    expect(toast.success).not.toHaveBeenCalled();
+    await act(async () => { resolveDelete({ data: {} }); });
+    expect(screen.queryByText('Saved Kandy')).toBeNull();
+    expect(screen.queryByRole('button', { name: 'Run Search Radar' })).toBeNull();
+    expect(toast.success).toHaveBeenCalledExactlyOnceWith('Search alert removed');
+    expect(toast.error).not.toHaveBeenCalled();
+});
+
+test('retains a runnable search after delete failure and reports no success', async () => {
+    api.delete.mockRejectedValue(new Error('Delete unavailable'));
+    await renderSearches();
+    fireEvent.click(screen.getByTitle('Delete search'));
+    await waitFor(() => expect(toast.error).toHaveBeenCalledExactlyOnceWith('Failed to delete search'));
+    expect(api.delete).toHaveBeenCalledExactlyOnceWith('/saved-searches/s1');
+    expect(screen.getByText('Saved Kandy')).toBeTruthy();
+    expect(screen.getByRole('button', { name: 'Run Search Radar' })).toBeTruthy();
+    expect(toast.success).not.toHaveBeenCalled();
+});
+
+test('runs the saved search by navigating with the entire persisted criteria and zero values', async () => {
+    await renderSearches();
+    fireEvent.click(screen.getByRole('button', { name: 'Run Search Radar' }));
+    expect(JSON.parse(screen.getByTestId('route').textContent)).toEqual({ pathname: '/map', state: { savedSearch } });
+    expect(api.patch).not.toHaveBeenCalled();
+    expect(api.delete).not.toHaveBeenCalled();
+});
diff --git a/frontend-react/src/pages/admin/context/AdminAuth.integration.test.jsx b/frontend-react/src/pages/admin/context/AdminAuth.integration.test.jsx
new file mode 100644
index 0000000..2596f4e
--- /dev/null
+++ b/frontend-react/src/pages/admin/context/AdminAuth.integration.test.jsx
@@ -0,0 +1,79 @@
+import React from 'react';
+import { act, cleanup, render, screen } from '@testing-library/react';
+import { MemoryRouter, Route, Routes } from 'react-router-dom';
+import { afterEach, beforeEach, describe, expect, test, vi } from 'vitest';
+import { AdminAuthProvider, useAdminAuth } from './AdminAuthContext';
+import AdminProtectedRoute from '../components/AdminProtectedRoute';
+
+const api = vi.hoisted(() => ({ verifyAdminSession: vi.fn(), adminLogout: vi.fn() }));
+vi.mock('../api/adminApi', () => api);
+
+function AdminDestination() {
+  const { admin } = useAdminAuth();
+  return <><h1>Admin destination</h1><output aria-label="Verified admin">{admin.id}:{admin.role}</output></>;
+}
+
+function show() {
+  return render(<MemoryRouter initialEntries={['/admin/dashboard']}><Routes>
+    <Route element={<AdminAuthProvider />}>
+      <Route path="/admin/login" element={<h1>Admin login destination</h1>} />
+      <Route element={<AdminProtectedRoute />}>
+        <Route path="/admin/dashboard" element={<AdminDestination />} />
+      </Route>
+    </Route>
+  </Routes></MemoryRouter>);
+}
+
+beforeEach(() => {
+  vi.resetAllMocks();
+  localStorage.clear();
+  api.verifyAdminSession.mockRejectedValue(new Error('Invalid session'));
+});
+
+afterEach(() => { cleanup(); localStorage.clear(); vi.restoreAllMocks(); });
+
+describe('Admin provider and route guard integration', () => {
+  test('stored admin profile alone cannot grant access without a token', async () => {
+    localStorage.setItem('admin_data', JSON.stringify({ id: 'forged-admin', role: 'ADMIN' }));
+    show();
+    expect(await screen.findByRole('heading', { name: 'Admin login destination' })).toBeInTheDocument();
+    expect(screen.queryByRole('heading', { name: 'Admin destination' })).not.toBeInTheDocument();
+    expect(api.verifyAdminSession).not.toHaveBeenCalled();
+  });
+
+  test('forged token and profile are rejected when server verification fails', async () => {
+    localStorage.setItem('admin_token', 'forged-token');
+    localStorage.setItem('admin_data', JSON.stringify({ id: 'forged-admin', role: 'ADMIN' }));
+    const consoleError = vi.spyOn(console, 'error').mockImplementation(() => {});
+    show();
+    expect(await screen.findByRole('heading', { name: 'Admin login destination' })).toBeInTheDocument();
+    expect(localStorage.getItem('admin_token')).toBeNull();
+    expect(localStorage.getItem('admin_data')).toBeNull();
+    expect(screen.queryByLabelText('Verified admin')).not.toBeInTheDocument();
+    expect(consoleError).toHaveBeenCalledWith('Admin session verification failed:', 'Invalid session');
+  });
+
+  test('protected content waits for server verification and uses verified identity', async () => {
+    localStorage.setItem('admin_token', 'fixture-session');
+    localStorage.setItem('admin_data', JSON.stringify({ id: 'forged-admin', role: 'ADMIN' }));
+    let finish;
+    api.verifyAdminSession.mockReturnValueOnce(new Promise(resolve => { finish = resolve; }));
+    show();
+    expect(screen.getByText('Loading...')).toBeInTheDocument();
+    expect(screen.queryByLabelText('Verified admin')).not.toBeInTheDocument();
+    const verified = { id: 'server-admin', name: 'Verified admin', role: 'ADMIN' };
+    await act(async () => finish({ valid: true, admin: verified }));
+    expect(await screen.findByRole('heading', { name: 'Admin destination' })).toBeInTheDocument();
+    expect(screen.getByLabelText('Verified admin')).toHaveTextContent('server-admin:ADMIN');
+    expect(JSON.parse(localStorage.getItem('admin_data'))).toEqual(verified);
+  });
+
+  test('a negative verification response denies access even with saved admin data', async () => {
+    localStorage.setItem('admin_token', 'fixture-invalid-session');
+    localStorage.setItem('admin_data', JSON.stringify({ id: 'forged-admin', role: 'ADMIN' }));
+    api.verifyAdminSession.mockResolvedValueOnce({ valid: false });
+    show();
+    expect(await screen.findByRole('heading', { name: 'Admin login destination' })).toBeInTheDocument();
+    expect(screen.queryByLabelText('Verified admin')).not.toBeInTheDocument();
+  });
+});
