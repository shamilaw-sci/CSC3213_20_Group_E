# Server Settings
PORT=5000
NODE_ENV=development

# Supabase Credentials (Get from Supabase Dashboard)
SUPABASE_URL=your_supabase_url_here
# Backend-only service_role key is required by checkout/receipt RPCs. Never expose in frontend.
SUPABASE_KEY=your_supabase_service_role_key_here

# Required for deployed Vercel receipt retry cron; set a random secret in host settings.
CRON_SECRET=

# JWT Secret for Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Social client identifiers: leave blank until the matching provider is configured.
# Missing provider audience/app configuration makes the matching API login unavailable.
GOOGLE_CLIENT_ID=
APPLE_SERVICES_ID=
FACEBOOK_APP_ID=
# Backend only. Never expose the app secret through VITE/build variables.
FACEBOOK_APP_SECRET=

# Frontend URL for CORS
CLIENT_URL=http://localhost:5173

# Keep sandbox unless live checkout is intentionally configured.
PAYHERE_MODE=sandbox
